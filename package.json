{
  "name": "nexomd",
  "version": "0.1.0",
  "description": "NexoMD — Editor Markdown Híbrido Nativo em Rust + Tauri v2 + Vue 3 + TypeScript",
  "author": "Edkallenn (@ed1rac) <edkevan@gmail.com>",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/ed1rac/nexomd.git"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:web": "vue-tsc --noEmit && vite build --outDir dist-web",
    "preview": "vite preview",
    "preview:web": "vite preview --outDir dist-web --port 4173",
    "tauri": "tauri",
    "build:native": "npm run build && cargo build --release --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "dompurify": "^3.2.2",
    "katex": "^0.16.15",
    "marked": "^14.1.3",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/katex": "^0.16.7",
    "@vitejs/plugin-vue": "^5.1.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.8"
  }
}
